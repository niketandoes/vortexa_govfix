# Local development database. Relative paths are resolved from the process directory.
GOVFIX_DATABASE_PATH=data/govfix.db

# Database Backend: 'mongodb', 'firestore', or 'sqlite'
DATABASE_BACKEND=mongodb

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/<DB_NAME>?retryWrites=true&w=majority
MONGO_DB_NAME=gov-fix

# Optional Plan 4 integration. The application must work without this value.
GEMINI_API_KEY=
